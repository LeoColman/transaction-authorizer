<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Perfil json (produção/containers): uma linha JSON por evento,
         pronto para coleta por agente de logs (CloudWatch, Loki, etc). -->
    <springProfile name="json">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"application":"transaction-authorizer"}</customFields>
            </encoder>
        </appender>
    </springProfile>

    <!-- Desenvolvimento local: legível por humanos. -->
    <springProfile name="!json">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
